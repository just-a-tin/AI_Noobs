# ---------------------------------------------------------------------------
# Sentinel configuration. Copy to `.env` and adjust.
#
# The defaults below run the ENTIRE stack offline with no AWS account and no
# credentials. Only flip MOCK_AWS to false once Bedrock model access has been
# enabled in your AWS account for the region below.
# ---------------------------------------------------------------------------

# Master switch. True = canned verdicts, in-memory cache, no AWS calls at all.
MOCK_AWS=true

# --- Turning on real AI -----------------------------------------------------
# Set MOCK_BEDROCK=false (and supply credentials below) for real analysis.
# Leave USE_DYNAMODB alone until the CDK stack is deployed — the in-memory
# cache works fine, and pointing at a table that does not exist only fills
# the logs with errors.
#
# Verify with:  python scripts/check_aws.py
#
# MOCK_BEDROCK=false
# USE_DYNAMODB=false

# Credentials. AWS console -> IAM -> Users -> Security credentials ->
# Create access key. NEVER commit these; .env is gitignored.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# SSO / temporary credentials additionally need a session token. Permanent IAM
# keys do not. Temporary keys start with ASIA and expire within hours.
# AWS_SESSION_TOKEN=...

# Bedrock model availability differs by region. us-east-1 and us-west-2 have
# the widest Claude selection; check before switching to an Asia-Pacific region.
AWS_REGION=us-east-1

# Which Bedrock API to call:
#   runtime - bedrock-runtime InvokeModel; ids like "us.anthropic.claude-..."
#   mantle  - the newer Messages-API endpoint; ids like "anthropic.claude-..."
# Default is runtime because it works in strictly more environments: managed
# AWS Organizations (hackathon, university and enterprise accounts) commonly
# carry a service control policy denying bedrock-mantle:* outright.
BEDROCK_API=runtime

# Being listed in the Bedrock catalogue is NOT the same as being entitled to
# call it. Find what this account can actually invoke:
#   python scripts/list_models.py --features
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1

DDB_TABLE_NAME=SentinelAnalysisCache
CACHE_TTL_HOURS=24

# A cached verdict is discarded early if the price moved more than this
# fraction, because bait-and-switch listings mutate their price.
CACHE_PRICE_TOLERANCE=0.02

# Total images (gallery + review) sent to the model in one request.
MAX_IMAGES=8

# Where the extension's service worker sends analysis requests.
SENTINEL_API_URL=http://localhost:8000

LOG_LEVEL=INFO
